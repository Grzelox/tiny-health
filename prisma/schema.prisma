generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  directUrl         = env("DIRECT_URL")
}

model KeepAlive {
  id     BigInt  @id @default(autoincrement())
  name   String  @default("")
  random String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  @@map("keep-alive")
}

model Pet {
  id        Int        @id @default(autoincrement())
  uuid      String     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  breed     String
  animalType String    @default("Mysz")
  bornAt    DateTime
  weight    Int
  color     String
  notes     String?    @db.Text
  ownerId   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isDead    Boolean    @default(false)
  deathDate DateTime?
  vetVisits VetVisit[]
  weights   Weight[]
  uploadedFiles File[]

  @@index([ownerId])
}

model UserShare {
  id          Int      @id @default(autoincrement())
  ownerId     String   
  sharedWith  String   
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([ownerId, sharedWith])
  @@index([sharedWith])
  @@index([ownerId])
}

model VetVisit {
  id          Int      @id @default(autoincrement())
  petId       Int
  date        DateTime
  description String
  medication  String

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model File {
  id        String   @id @default(uuid())
  petId     Int
  url       String
  createdAt DateTime @default(now())

  pet Pet @relation(fields: [petId], references: [id], onDelete: Cascade)
}

model Weight {
  id        Int      @id @default(autoincrement())
  date      DateTime @default(now())
  weight    Float
  petId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
}

