{
  "name": "tiny-health",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate": "prisma generate",
    "test": "jest",
    "db:docker:up": "docker compose up -d --wait postgres && npm run generate && prisma migrate deploy && node prisma/local-seed.mjs",
    "db:docker:down": "docker compose down",
    "db:docker:reset": "docker compose down -v && npm run db:docker:up",
    "vercel-build": "prisma generate && prisma migrate deploy && next build"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
