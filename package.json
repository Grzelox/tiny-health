    "@clerk/nextjs": "^6.36.2",
    "@prisma/client": "^6.0.1",
    "@tanstack/react-query": "^5.90.12",
    "@tanstack/react-query-devtools": "^5.91.1",
    "@types/google-one-tap": "^1.2.7",
    "classnames": "^2.5.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.26",
    "generic-pool": "^3.9.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.561.0",
    "marked": "^15.0.12",
    "next": "^16.0.10",
    "next-intl": "^4.13.0",
    "pg": "^8.16.3",
